# ============================================================
# Configuration Development LOCAL (sans Docker)
# À utiliser pour: php artisan serve
# ============================================================

# Application
APP_NAME="Camwater Pro"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

# Key (garder la même)
APP_KEY=base64:Sqr99WSO3ouXih0X/H0MOZv1imvq5e7vJatRI/tL9lI=

# ── Connexion à MySQL (LOCAL) ────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=camwater_db
DB_USERNAME=root
DB_PASSWORD=

# ── Session Driver (FILE au lieu de DATABASE) ────────────
SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# ── Désactiver Redis pour le développement local ────────
# (Ne pas utiliser camwater_redis qui est dans Docker)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=your-secret-key-here

# ── Logging ──────────────────────────────────────────────
LOG_CHANNEL=single
LOG_LEVEL=debug

# ── Mail (Optionnel) ─────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@camwater.local"
MAIL_FROM_NAME="Camwater Pro"
